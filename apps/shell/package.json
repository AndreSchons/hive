{
  "name": "@hive/shell",
  "version": "0.0.1",
  "private": true,
  "main": "./dist/main/main.js",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run --passWithNoTests",
    "start": "electron .",
    "dev": "node scripts/dev.mjs",
    "postinstall": "install-electron",
    "start:nosandbox": "electron . --no-sandbox",
    "dist": "node scripts/bundle.mjs && electron-builder"
  },
  "dependencies": {
    "@hive/agents": "workspace:*",
    "@hive/coordination": "workspace:*",
    "@hive/protocol": "workspace:*",
    "@hive/simulator": "workspace:*",
    "@hive/store": "workspace:*",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "electron": "44.0.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2"
  },
  "productName": "Hive",
  "build": {
    "appId": "app.hive.desktop",
    "productName": "Hive",
    "directories": {
      "app": "app",
      "output": "release"
    },
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "Hive-Setup-${version}.${ext}"
    }
  }
}
