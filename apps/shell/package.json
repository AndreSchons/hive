{
  "name": "@hive/shell",
  "version": "0.0.1",
  "private": true,
  "main": "./dist/main/main.js",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run --passWithNoTests",
    "start": "electron .",
    "dev": "node scripts/dev.mjs",
    "postinstall": "install-electron",
    "start:nosandbox": "electron . --no-sandbox",
    "dist": "node scripts/bundle.mjs && electron-builder"
  },
  "dependencies": {
    "@hive/agents": "workspace:*",
    "@hive/coordination": "workspace:*",
    "@hive/protocol": "workspace:*",
    "@hive/simulator": "workspace:*",
    "@hive/store": "workspace:*",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "electron": "44.0.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2"
  },
  "productName": "Hive",
  "build": {
    "appId": "app.hive.desktop",
    "productName": "Hive",
    "directories": {
      "app": "app",
      "output": "release"
    },
    "npmRebuild": false,
    "afterPack": "scripts/after-pack.cjs",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "Hive-Setup.${ext}"
    },
    "toolsets": {
      "appimage": "1.0.3"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "executableName": "hive",
      "category": "Development",
      "synopsis": "Escritorio de agentes de IA que trabalham no seu projeto.",
      "maintainer": "Andre Schons <andreferens86@gmail.com>",
      "icon": "build/icon.png"
    },
    "appImage": {
      "artifactName": "Hive.${ext}"
    },
    "deb": {
      "artifactName": "Hive.${ext}",
      "appArmorProfile": "build/apparmor-profile"
    }
  }
}
