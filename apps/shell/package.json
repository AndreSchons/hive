{
  "name": "@hive/shell",
  "version": "0.0.1",
  "private": true,
  "main": "./dist/main/main.js",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run --passWithNoTests",
    "start": "electron .",
    "dev": "node scripts/dev.mjs",
    "postinstall": "install-electron",
    "start:nosandbox": "electron . --no-sandbox"
  },
  "dependencies": {
    "@hive/agents": "workspace:*",
    "@hive/coordination": "workspace:*",
    "@hive/protocol": "workspace:*",
    "@hive/simulator": "workspace:*",
    "@hive/store": "workspace:*",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "electron": "44.0.0"
  },
  "productName": "Hive"
}
